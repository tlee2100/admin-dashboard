# NextAuth
AUTH_SECRET=your_auth_secret_here

# Server-side calls to the NestJS backend (auth.ts, API routes)
API_URL=http://localhost:3000

# Client-side calls to the NestJS backend (users page, etc.)
NEXT_PUBLIC_API_URL=http://localhost:3000

# reCAPTCHA v3 site key (matches RECAPTCHA_SECRET_KEY in the backend .env)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# WebSockets URL for real-time notifications
NEXT_PUBLIC_WS_URL=http://localhost:3000/notifications

# Feature Flags
NEXT_PUBLIC_DISABLE_RECAPTCHA=true

# Pagination Configuration
NEXT_PUBLIC_CHAT_PAGE_SIZE=10
